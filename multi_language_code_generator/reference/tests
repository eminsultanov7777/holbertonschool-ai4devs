
from log_analyzer import LogAnalyzer
def test_normal_log_file():
    lines = [
        "2026-11-16 10:00:00 INFO Server started",
        "2026-11-16 10:05:00 WARNING High memory usage",
        "2026-11-16 10:10:00 ERROR Connection failed",
        "2026-11-16 10:15:00 INFO User logged in",
        "2026-11-16 10:20:00 ERROR Database unavailable",
    ]
    result = LogAnalyzer().analyze(lines)
    assert result == {"total_entries": 5, "info_count": 2, "warning_count": 1,
        "error_count": 2, "malformed_count": 0, "error_rate": 40.0,
        "most_common_level": "INFO"}

from log_analyzer import LogAnalyzer
def test_empty_input():
    result = LogAnalyzer().analyze([])
    assert result["total_entries"] == 0
    assert result["error_rate"] == 0.0
    assert result["most_common_level"] is None

from log_analyzer import LogAnalyzer
def test_only_error_messages():
    lines = [f"2026-11-16 10:0{i}:00 ERROR Failure {i}" for i in range(3)]
    result = LogAnalyzer().analyze(lines)
    assert result["error_count"] == 3
    assert result["error_rate"] == 100.0
    assert result["most_common_level"] == "ERROR"

from log_analyzer import LogAnalyzer
def test_mixed_valid_and_malformed():
    lines = ["2026-11-16 10:00:00 INFO Started", "bad line",
             "2026-11-16 10:01:00 ERROR Failed",
             "2026-11-16 10:02:00 INFO Retried",
             "2026-11-16 10:03:00 DEBUG Debug"]
    result = LogAnalyzer().analyze(lines)
    assert result["total_entries"] == 3
    assert result["malformed_count"] == 2
    assert result["error_rate"] == 33.33
    assert result["most_common_level"] == "INFO"

from log_analyzer import LogAnalyzer
def test_tie_breaking_prefers_info():
    lines = ["2026-11-16 10:00:00 INFO A",
             "2026-11-16 10:01:00 WARNING B",
             "2026-11-16 10:02:00 ERROR C"]
    assert LogAnalyzer().analyze(lines)["most_common_level"] == "INFO"

from log_analyzer import LogAnalyzer
def test_invalid_timestamp_is_malformed():
    result = LogAnalyzer().analyze(["not-a-date 10:00:00 ERROR Broken"])
    assert result["total_entries"] == 0
    assert result["malformed_count"] == 1

from log_analyzer import LogAnalyzer
def test_duplicate_timestamps_are_counted():
    lines = ["2026-11-16 10:00:00 INFO First",
             "2026-11-16 10:00:00 ERROR Second"]
    result = LogAnalyzer().analyze(lines)
    assert result["total_entries"] == 2
    assert result["info_count"] == 1
    assert result["error_count"] == 1

from log_analyzer import LogAnalyzer
def test_single_valid_entry():
    result = LogAnalyzer().analyze(["2026-11-16 10:00:00 WARNING Disk low"])
    assert result["total_entries"] == 1
    assert result["warning_count"] == 1
    assert result["error_rate"] == 0.0
    assert result["most_common_level"] == "WARNING"

import tempfile
from pathlib import Path
import pytest
from log_analyzer import analyze_file
def test_missing_file_raises_error():
    with tempfile.TemporaryDirectory() as directory:
        missing = Path(directory) / "missing.log"
        with pytest.raises(FileNotFoundError):
            analyze_file(missing)
